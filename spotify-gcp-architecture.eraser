title Spotify Zero-Trust Security & Multi-Modal Streaming Architecture — GCP

direction right

// ============================================================
// COLUMNS — LAYERS 1 TO 7
// ============================================================

// Layer 1 — Client
Client [icon: spotify] {
  Media Player [icon: play-circle, label: "Media Player — ABR HLS/DASH + AV1 Canvas Sync"]
  Local DSP [icon: sliders, label: "Local DSP — Client MIX (0.75x-1.5x BPM)"]
  CDM Vault [icon: lock, label: "DRM CDM — Widevine / FairPlay Offline Vault"]
}

// Layer 2 — Edge Security & Delivery
Edge Perimeter [icon: google-cloud] {
  WAF [icon: gcp-cloud-armor, label: "Cloud Armor — Anycast DDoS & WAF (L3/L4/L7)"]
  API Gateway [icon: gcp-apigee-api-platform, label: "Apigee API Gateway — OAuth2/OIDC, BOLA Check, Rate Limit"]
  Cloud CDN [icon: gcp-cloud-cdn, label: "Cloud CDN — Signed URLs / Cookies"]
}

// Layer 3 — Zero-Trust Control Plane
Zero-Trust Mesh [icon: gcp-anthos-service-mesh] {
  Playback [icon: gcp-google-kubernetes-engine, label: "Playback & Session Service (GKE, mTLS)"]
  Catalog [icon: gcp-google-kubernetes-engine, label: "Catalog & Beat-Grid Service (GKE, mTLS)"]
  Podcast [icon: gcp-google-kubernetes-engine, label: "Podcast & DAI Splice Service (GKE, mTLS)"]
  Playlist [icon: gcp-google-kubernetes-engine, label: "Playlist Service — RBAC/ABAC (GKE, mTLS)"]
  DRM Server [icon: gcp-key-management-service, label: "DRM License Server — CENC Keys via Cloud KMS"]
}

// Layer 4 — AI Playlist & Guardrail Pipeline
AI Pipeline [icon: gcp-vertexai] {
  Guardrail [icon: google-cloud, label: "Model Armor — Prompt Injection Guardrail & Token Quota"]
  LLM [icon: gemini, label: "Vertex AI Gemini — Scoped User JWT + JSON Schema"]
  Vector DB [icon: gcp-vertexai, label: "Vertex AI Vector Search — Mood & Transcript Embeddings"]
}

// Layer 5 — Media Ingestion & Sandboxed Transcoding
Ingestion [icon: gcp-cloud-storage] {
  Staging Bucket [icon: gcp-cloud-storage, label: "Cloud Storage Staging + Malware/Header Scan"]
  Job Queue [icon: gcp-pubsub, label: "Pub/Sub (Managed Kafka) Media Job Queue"]
  Sandbox Workers [icon: gcp-containers, label: "GKE Sandbox (gVisor) FFmpeg / DSP / Speech-to-Text"]
}

// Layer 6 — Polyglot Persistence & Secrets
Data Plane [icon: gcp-secret-manager] {
  Secrets Vault [icon: gcp-secret-manager, label: "Secret Manager + Cloud KMS Envelope Keys"]
  Redis [icon: gcp-memorystore, label: "Memorystore Redis — Session State & JWT Revocation"]
  PostgreSQL [icon: gcp-cloud-sql, label: "Cloud SQL PostgreSQL — Billing/Royalties + WORM Backup"]
  Cassandra [icon: gcp-bigtable, label: "Cassandra / Bigtable — Track, Resume & Beat-Grid Metadata"]
  Media Store [icon: gcp-cloud-storage, label: "Cloud Storage — Encrypted Media (HLS, AV1, DAI)"]
}

// Layer 7 — SecOps, Telemetry & Fraud Detection
SecOps [icon: gcp-security-operations] {
  Telemetry Bus [icon: gcp-dataflow, label: "Pub/Sub + Dataflow Telemetry Bus"]
  UEBA [icon: gcp-security-command-center, label: "Security Command Center — Fraud & Tempo Anomaly UEBA"]
  Runtime Sensor [icon: terminal, label: "Falco eBPF Runtime Sensor (GKE Addon)"]
  SIEM SOAR [icon: gcp-security-operations, label: "Google SecOps (Chronicle) SIEM + SOAR Playbooks"]
}

// ============================================================
// STEPS 1 TO 30 — NUMBERED FLOW
// ============================================================

// Steps 1-6: Client request enters Edge, fans out via API Gateway
Media Player > WAF: 1. HTTPS / TLS 1.3
WAF > API Gateway: 2. Inspected Traffic
API Gateway > Playback: 3. mTLS + Scoped JWT
API Gateway > Catalog, Podcast, Playlist: 4-6. mTLS

// Steps 7-12: Services fetch keys, sessions, and metadata
Playback > DRM Server: 7. Request CENC Session Keys
DRM Server > Secrets Vault: 8. Fetch Root KMS Keys
Playback > Redis, PostgreSQL: 9-10. Token Check + Device Sync / Verify Subscription Tier
Catalog > Cassandra: 11. Read Track & MIX Metadata
Podcast > Cassandra: 12. Read Resume Cursors

// Steps 13-15: Content delivered back to the client
Catalog --> Local DSP: 13. BPM & Beat-Grid JSON
Media Player > Cloud CDN: 14. Fetch Encrypted HLS + AV1 Canvas (Signed URL)
Cloud CDN > Media Store: 15. Origin Fetch (on cache miss)

// Steps 16-19: AI playlist generation pipeline
API Gateway > Guardrail: 16. POST /playlists/ai-generate
Guardrail > LLM: 17. Sanitized Prompt
LLM > Vector DB: 18. Semantic RAG Lookup
LLM --> Playlist: 19. Validated Track IDs (Scoped User JWT)

// Steps 20-23: Media ingestion & sandboxed transcoding
Staging Bucket > Job Queue: 20. Verified Master Assets
Job Queue > Sandbox Workers: 21. Dispatch Job
Sandbox Workers > Media Store: 22. Write Encrypted HLS + AV1 + DAI
Sandbox Workers > Cassandra: 23. Write BPM Beat-Grids & Transcripts

// Steps 24-28: Telemetry & fraud detection
Playback > Telemetry Bus: 24. Stream & Tempo Events
API Gateway > Telemetry Bus: 25. Edge Audit Logs
Telemetry Bus > UEBA: 26. Detect Bot / 10x Speed Abuse
Runtime Sensor > SIEM SOAR: 27. Container Syscall Alerts
UEBA > SIEM SOAR: 28. High-Confidence Threat Alert

// Steps 29-30: Automated response (dashed return edges)
SIEM SOAR --> Redis: 29. Revoke Compromised JWT
SIEM SOAR --> WAF: 30. Block Malicious IP / ASN
